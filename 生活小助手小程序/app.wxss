/* ===== 基础重置 ===== */
page {
  background: var(--theme-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  color: var(--theme-text);
  font-size: calc(28rpx * var(--app-font-scale, 1));
}

view, text, input, textarea, button, image, scroll-view, navigator, picker {
  box-sizing: border-box;
}

/* ===== 页面内容容器 ===== */
.screen {
  /* 全局字体设置：由设置页经 .screen 内联 style 注入实际值，此处为兜底 */
  --app-font-scale: 1;
  --app-font-weight: 400;
  width: 100%;
  min-height: 100vh;
  background: var(--theme-bg);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-x: hidden;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: var(--app-font-weight, 400);
}

.content-wrapper {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  background: var(--theme-bg);
  padding-bottom: 220rpx;
}

/* ===== 头部 ===== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.app-title {
  font-size: calc(48rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: var(--theme-text-tertiary);
  line-height: 1;
}

/* ===== 余额卡片 ===== */
.balance-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  gap: 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, var(--theme-gradient-start) 0%, var(--theme-gradient-end) 100%);
  box-shadow: 0 12rpx 30rpx var(--theme-shadow);
}
.balance-left {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.balance-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.balance-label {
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: 500;
  color: #FFFFFF;
}
.balance-value {
  font-size: calc(56rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: #FFFFFF;
}
.account-balance-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.account-balance-tag {
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  font-size: calc(20rpx * var(--app-font-scale, 1));
}
.balance-right {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== 快速统计行 ===== */
.stats-row {
  display: flex;
  gap: 20rpx;
}
.stat-card {
  flex: 1;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-radius: 32rpx;
  background: var(--theme-card-bg);
  border: 3rpx solid var(--theme-border);
}
.stat-label {
  font-size: calc(22rpx * var(--app-font-scale, 1));
  font-weight: 400;
  color: var(--theme-text-secondary);
}
.stat-value {
  font-size: calc(32rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: var(--theme-text);
}

/* ===== 通用卡片 ===== */
.card {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  border-radius: 48rpx;
  background: var(--theme-card-bg);
  border: 3rpx solid var(--theme-border);
  box-shadow: 0 8rpx 24rpx var(--theme-shadow-light);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.card-title {
  font-size: calc(34rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: var(--theme-text-secondary);
}
.date-pill, .total-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: var(--theme-tab-bg);
}
.date-pill-text {
  font-size: calc(24rpx * var(--app-font-scale, 1));
  font-weight: 500;
  color: var(--theme-text-tertiary);
}
.total-pill-text {
  font-size: calc(26rpx * var(--app-font-scale, 1));
  font-weight: 500;
  color: var(--theme-text-tertiary);
}

/* ===== 支出列表 ===== */
.expense-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.expense-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.expense-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.record-labels {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.record-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.cat-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.expense-text {
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: 400;
  color: var(--theme-text);
}
.expense-amount {
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: var(--theme-text);
}
.amount-income, .record-income {
  color: var(--theme-income);
}
.amount-expense, .record-expense {
  color: var(--theme-expense);
}
.record-type-tag {
  width: fit-content;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-size: calc(18rpx * var(--app-font-scale, 1));
  font-weight: 600;
  background: rgba(22, 131, 84, 0.1);
}
.record-type-tag.record-expense {
  background: rgba(207, 79, 79, 0.1);
}
.scope-tag {
  font-size: calc(18rpx * var(--app-font-scale, 1));
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.scope-family { background: #FCE4EC; color: #E91E63; }
.scope-personal { background: #E0F7FA; color: #00BCD4; }
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: var(--theme-text-tertiary);
  font-size: calc(26rpx * var(--app-font-scale, 1));
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 40rpx;
  border: none;
  width: 100%;
}
.btn-green {
  background: var(--theme-accent);
  box-shadow: 0 6rpx 16rpx rgba(var(--theme-accent-rgb), 0.3);
}
.btn-pink {
  background: var(--theme-primary);
  box-shadow: 0 6rpx 16rpx rgba(var(--theme-primary-rgb), 0.3);
}
.account-action-row {
  display: flex;
  gap: 20rpx;
}
.account-action-row .btn { flex: 1; }
.btn-expense {
  background: var(--theme-expense-btn);
  box-shadow: 0 6rpx 16rpx rgba(207, 79, 79, 0.28);
}
.btn-income {
  background: var(--theme-income-btn);
  box-shadow: 0 6rpx 16rpx rgba(43, 160, 71, 0.28);
}
.btn-text {
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: #FFFFFF;
}
.btn:active { opacity: 0.85; transform: scale(0.98); }

/* ===== 复选列表（刚需/愿望） ===== */
.check-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.check-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--theme-card-bg);
  border: 4rpx solid var(--theme-check-border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox.checked {
  background: var(--theme-accent);
  border-color: var(--theme-accent);
}
.check-item-name {
  flex: 1;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: 400;
  color: var(--theme-text);
}
.check-item-price {
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: 500;
  color: var(--theme-text-tertiary);
}
.check-item-delete {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  color: var(--theme-text-secondary);
  flex-shrink: 0;
  opacity: 0.5;
}
.check-item-delete:active { opacity: 1; }

/* ===== 筛选 pill ===== */
.filter-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.filter-scroll-row {
  flex-wrap: nowrap;
  overflow-x: auto;
  padding-bottom: 4rpx;
}
.filter-scroll-row .filter-pill { flex-shrink: 0; }
.date-range-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.date-range-row .date-pill {
  padding-left: 16rpx;
  padding-right: 16rpx;
}
.date-range-divider {
  color: var(--theme-text-secondary);
  font-size: calc(22rpx * var(--app-font-scale, 1));
  flex-shrink: 0;
}
.filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  font-size: calc(24rpx * var(--app-font-scale, 1));
  font-weight: 500;
  background: var(--theme-card-bg);
  color: var(--theme-text-secondary);
  border: 3rpx solid var(--theme-text-secondary);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.7), 0 2rpx 6rpx var(--theme-shadow-xs);
  transition: all 0.12s ease;
}
.filter-pill.active {
  background: #FFFFFF;
  color: #333333;
  font-weight: 700;
  border: 4rpx solid var(--theme-primary);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
}
.filter-pill.inactive {
  background: var(--theme-card-bg);
  color: var(--theme-text-secondary);
  font-weight: 500;
  border-color: var(--theme-text-secondary);
}
.filter-pill.pill-tap { transform: scale(0.96); }
.filter-pill.active.pill-tap { box-shadow: inset 0 4rpx 8rpx rgba(0, 0, 0, 0.1), 0 4rpx 8rpx rgba(0, 0, 0, 0.12); }

/* ===== 消费统计（环形图 + 图例） ===== */
.chart-area {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.doughnut-canvas {
  width: 260rpx;
  height: 260rpx;
  flex-shrink: 0;
}
.legend-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
