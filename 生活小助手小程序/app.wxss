/* ============================================================
   生活小助手 - 全局样式 + 主题配色系统
   通过 .theme-{name} 类切换整套配色，各页面根节点添加对应 class
   ============================================================ */

/* ===== 主题配色变量定义 ===== */
.theme-default {
  --theme-bg: #FDF8F4;
  --theme-primary: #F4B8B8;
  --theme-primary-rgb: 244, 184, 184;
  --theme-accent: #B0D9B1;
  --theme-accent-rgb: 176, 217, 177;
  --theme-text: #5E4B3C;
  --theme-text-secondary: #C88E8E;
  --theme-text-tertiary: #D99B9B;
  --theme-border: rgba(250, 229, 229, 1);
  --theme-card-bg: #FFFFFF;
  --theme-pill-bg: rgba(255, 242, 242, 1);
  --theme-primary-light: rgba(244, 184, 184, 0.15);
  --theme-accent-light: rgba(176, 217, 177, 0.15);
  --theme-overlay: rgba(193, 124, 138, 0.94); /* 马卡龙实心遮罩：深樱花粉，近不透明，背景不再透出干扰编辑界面 */
  --theme-shadow: rgba(114, 95, 95, 0.25);
  --theme-shadow-light: rgba(114, 95, 95, 0.12);
  --theme-shadow-xs: rgba(114, 95, 95, 0.06);
  --theme-handle: rgba(200, 142, 142, 0.3);
  --theme-tab-bg: #FFF4E6;
  --theme-income: #168354;
  --theme-expense: #CF4F4F;
  --theme-income-btn: #55A779;
  --theme-expense-btn: #E07A7A;
  --theme-gradient-start: #F4B8B8;
  --theme-gradient-end: #B0D9B1;
  --theme-weight: #7B4B8A;
  --theme-weight-light: #B39DDB;
  --theme-disabled: #E0E0E0;
  --theme-record-dot: rgba(200, 142, 142, 0.25);
  --theme-record-text: #8B7355;
  --theme-complete: #81C784;
  --theme-check-border: rgba(245, 204, 204, 1);
  --theme-avatar-border: rgba(244, 184, 184, 0.3);
  --theme-settings-icon-bg: rgba(244, 184, 184, 0.12);
  --theme-cat-btn-bg: rgba(244, 184, 184, 0.1);
  --theme-profile-gradient-start: #FFFFFF;
  --theme-profile-gradient-end: #FFF8F4;
  --theme-normal-text: #999;
  --theme-ref-text: #6FA870;
}

