  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0.4;
}
.li-del-btn:active { opacity: 1; }
.li-checkin-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: white;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}
.li-checkin-name { flex: 1; font-size: calc(28rpx * var(--app-font-scale, 1)); color: var(--theme-text); min-width: 0; }
.li-checkin-streak { font-size: calc(22rpx * var(--app-font-scale, 1)); color: var(--theme-normal-text); flex-shrink: 0; }
.li-checkin-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 4rpx solid var(--theme-accent);
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.li-checkin-btn.checked { background: var(--theme-accent); border-color: var(--theme-accent); }
.li-priority-selector {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}
.li-priority-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
